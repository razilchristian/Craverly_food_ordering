# Cravely - Food Ordering System
# Environment Configuration Template (Placeholders only - Do not commit actual secrets)

# Server Configuration
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=default

# Database Configuration (MySQL 8)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/cravely_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Security
JWT_SECRET=your_base64_encoded_256bit_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_placeholder

# Frontend Base URL (for CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173

