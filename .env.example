# ===================================================================
# Cravely - Food Ordering System
# Environment Configuration Template
# (Placeholders only - Copy to .env and provide genuine secrets)
# ===================================================================

# Server Configuration (Render assigns PORT dynamically)
PORT=8081
SPRING_PROFILES_ACTIVE=default
# For production on Render, set: SPRING_PROFILES_ACTIVE=prod

# Managed MySQL 8 Database Configuration
# Local Dev Default:
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/cravely_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# Managed Cloud MySQL Example (Aiven / AWS RDS / PlanetScale / DigitalOcean):
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql-cravely-db.aivencloud.com:12345/defaultdb?sslmode=require&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=avnadmin
# SPRING_DATASOURCE_PASSWORD=your_aiven_cloud_password

# Database Connection Pool
DB_POOL_SIZE=10
DB_MIN_IDLE=2

# Hibernate DDL Mode: 'update' for dev; 'validate' or 'none' for production
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Security (Generate a secure base64 256-bit key for production)
JWT_SECRET=your_base64_encoded_256bit_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# Razorpay Credentials
# Test Mode:
RAZORPAY_KEY_ID=rzp_test_your_test_key_here
RAZORPAY_KEY_SECRET=your_razorpay_test_secret_here
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret_here
RAZORPAY_CURRENCY=INR

# Live Mode (For Production):
# RAZORPAY_KEY_ID=rzp_live_your_live_key_here
# RAZORPAY_KEY_SECRET=your_razorpay_live_secret_here
# RAZORPAY_WEBHOOK_SECRET=your_live_webhook_secret_here

# CORS Allowed Origins (Comma-separated frontend domains)
# Example: http://localhost:5173,https://cravely.vercel.app,https://*.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
