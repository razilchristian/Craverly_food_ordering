# ===================================================================
# Cravely Frontend - Environment Configuration Template
# ===================================================================

# Base URL for the Spring Boot Backend REST API
# Local Development:
VITE_API_BASE_URL=http://localhost:8081/api

# Production (Set on Vercel Dashboard to your Render backend service):
# VITE_API_BASE_URL=https://cravely-backend.onrender.com/api

# Razorpay Standard Checkout Key ID
# Test Mode:
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder

# Live Mode (Production):
# VITE_RAZORPAY_KEY_ID=rzp_live_placeholder
